# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for Google Identity Services (GIS).
# Used for optional personal Google Drive cloud backup and YouTube playlist authorization.
# Public Web Client ID (ending in .apps.googleusercontent.com). Safe for client browser.
# Configured once by the app owner/admin in the AI Studio environment dialog.
VITE_GOOGLE_CLIENT_ID=""

# YouTube Integration:
# YouTube reference lookups and playlist imports run directly in the browser using
# optional user-supplied API keys (stored locally in the user's browser) or Google OAuth.
# No server-side YOUTUBE_API_KEY environment variable is required or used.
